# --- required: every stage is an OpenAI agent ---
OPENAI_API_KEY=

# --- tuning (defaults are fine) ---
OPENAI_MODEL=gpt-5.6-terra          # intake, personas, creatives, summary
OPENAI_MATCH_MODEL=gpt-5.6-sol      # the judgement-heavy matcher
REASONING_EFFORT=low
MATCH_REASONING_EFFORT=medium
LLM_TIMEOUT_S=90

SUMMARY_STAGE_ENABLED=true
TRACING_ENABLED=true

# public URL(s) of the frontend, comma-separated (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# --- OpenAI Agents SDK features ---
SESSIONS_DB=sessions.db             # SQLiteSession store for intake memory (per browser session)
SESSION_HISTORY_LIMIT=20            # how many past items a session replays into the run
CODE_INTERPRETER_ENABLED=false      # give the summary agent the hosted CodeInterpreterTool sandbox
