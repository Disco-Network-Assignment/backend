# --- required for LLM mode (leave empty to run the deterministic heuristic mode) ---
OPENAI_API_KEY=

# --- tuning (defaults are fine) ---
# judgement-heavy matcher on the strongest tier, the rest on the balanced tier
OPENAI_INTAKE_MODEL=gpt-5.6-terra
OPENAI_MATCH_MODEL=gpt-5.6-sol
OPENAI_PERSONA_MODEL=gpt-5.6-terra
OPENAI_CREATIVE_MODEL=gpt-5.6-terra
OPENAI_SUMMARY_MODEL=gpt-5.6-luna
MATCH_REASONING_EFFORT=medium
LLM_TIMEOUT_S=90

# llm | heuristic  (llm falls back to heuristic when the key is empty)
EXECUTION_MODE=llm
SUMMARY_STAGE_ENABLED=true
STAGE_CACHE_ENABLED=true
TRACING_ENABLED=true

# public URL(s) of the frontend, comma-separated (CORS)
FRONTEND_ORIGIN=http://localhost:5173
